# Environment Configuration Template (Placeholder only — no secrets)
# Copy to .env for local overrides if needed.

# Application Environment
APP_ENV=development
LOG_LEVEL=INFO

# SQLite Database Location (defaults to ./pharmacy.db)
PHARMACY_DB_PATH=pharmacy.db

# MLflow Tracking URI (defaults to sqlite:///mlflow.db)
MLFLOW_TRACKING_URI=sqlite:///mlflow.db
MLFLOW_EXPERIMENT_NAME=pharma-eval

# Streamlit Port Configuration
STREAMLIT_SERVER_PORT=8501
STREAMLIT_SERVER_ADDRESS=localhost
